rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.id == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['id', 'email', 'displayName', 'instagramHandle', 'preferredTheme', 'defaultSetupId', 'availableObstacles', 'dashboardPreferences', 'toolIds', 'importedLocalProfiles', 'cloudRevision', 'preferredDifficultyRange'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80;
      match /{bucket}/{recordId} {
        allow read, delete: if owns(uid) && bucket in ['sessions', 'savedSetups', 'bookmarks', 'poolPresets', 'trickLibrary'];
        allow create, update: if owns(uid)
          && bucket in ['sessions', 'savedSetups', 'bookmarks', 'poolPresets', 'trickLibrary']
          && request.resource.data.id == recordId;
      }
    }
  }
}
